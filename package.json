{
  "name": "@itookit/ui-common",
  "version": "0.1.0",
  "description": "Dependency-free native DOM navigation and content title bars.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./navigation.css": "./src/styles/navigation.css",
    "./components.css": "./src/styles/components.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./navigation.css": "./dist/navigation.css",
      "./components.css": "./dist/components.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "jsdom": "^27.4.0",
    "@types/node": "^20.19.25"
  },
  "packageManager": "pnpm@10.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-agentos/ui-common.git"
  },
  "homepage": "https://github.com/nest-agentos/ui-common#readme",
  "bugs": {
    "url": "https://github.com/nest-agentos/ui-common/issues"
  }
}
